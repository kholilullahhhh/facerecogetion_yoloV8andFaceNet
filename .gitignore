# Dependencies
node_modules/
vendor/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Environment
.env
.env.local
.env.production

# Model weights
*.pt
*.pth
*.onnx
*.tflite
# The MediaPipe face detector is a small public model the web app needs at
# runtime; unlike trained weights it is safe to ship (Apache-2.0).
!frontend/public/mediapipe/blaze_face_short_range.tflite

# Datasets
datasets/
ai-service/datasets/

# Storage
backend/storage/app/public/faces/*
backend/storage/app/public/students/*
backend/storage/app/public/attendance/*
!backend/storage/app/public/faces/.gitkeep
!backend/storage/app/public/students/.gitkeep
!backend/storage/app/public/attendance/.gitkeep

# Build
frontend/.next/
frontend/out/
backend/vendor/

# Vendored MediaPipe WASM (regenerated on npm install)
frontend/public/mediapipe/wasm/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
